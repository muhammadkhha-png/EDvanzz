  "ConnectionStrings": {
    // DESIGN-TIME PLACEHOLDER ONLY — never a real database. Runtime environments MUST supply
    // ConnectionStrings__con (Azure App Service setting in prod; appsettings.Development.json
    // locally). Program.cs refuses to start if it sees this marker at runtime, so a container
    // that boots without app settings (the App Service first-boot quirk) fails fast and clear
    // instead of dialing dead credentials. The marker keeps `dotnet ef migrations script`
    // working on CI, which builds the host but never connects.
    "con": "Server=localhost;Database=EDVANZ_DESIGN_TIME_ONLY;Integrated Security=True;TrustServerCertificate=True;"
  },
