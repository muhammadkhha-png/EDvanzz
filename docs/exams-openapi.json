{
  "openapi": "3.0.3",
  "info": {
    "title": "Edvanz — Exams Module API",
    "version": "1.1",
    "description": "Offline **Exams** endpoints (`/api/exams/*`) plus the exam-related extension of the attendance dashboard.\n\n**Auth:** every endpoint requires a Teacher/Assistant Bearer JWT (`Authorization: Bearer <token>`). `teacherId` is taken from the token — never sent in the body.\n\n**Envelope:** every response is `{ success, code, message, data }`. `code` is a stable, language-independent string you branch on; `message` is localized (Accept-Language: `en` | `ar`).\n\n**Batch endpoints** (grades, attendance) return HTTP **200** even when some rows are invalid — check `data.allSucceeded` and each `data.items[].success` / `data.items[].code`. A concurrency conflict fails the whole batch with **409**.\n\n**Delivery types:** `DuringSession` (exam taken inside a scheduled session occurrence — attendance is synced from that session and is **read-only** in the exam) vs `SeparateTime` (its own date — attendance is taken in the exam via `/attendance` or `/attendance/scan`).\n\n**v1.1 additions:** send `grade: null` on `PUT /api/exams/grades` to **clear** an entered grade (the student reverts to `Attended`, attendance kept); opened-exam sessions carry **`attendanceTaken`/`gradesTaken`** (drive the *Take* vs *Edit* labels) and the exam carries **`distinctStudentCount`**; each home card carries **`totalStudents`** and **`pendingCount`**.\n"
  },
  "servers": [
    {
      "url": "https://app-edvanz-api-prod.azurewebsites.net",
      "description": "Production"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Exams"
    },
    {
      "name": "Exam grades & attendance"
    },
    {
      "name": "Home / dashboard"
    }
  ],
  "paths": {
    "/api/exams": {
      "post": {
        "tags": [
          "Exams"
        ],
        "summary": "Create an offline exam",
        "description": "Creates an exam anchored to one or more sessions. **One occurrence is materialized per session.** For `DuringSession`, each session entry must carry `sessionOccurrenceId` (pick it from `GET /api/exams/session-dates`); for `SeparateTime`, each entry carries `examDate` (today or future). `studentIds` optionally narrows to a subset of that session's students (they must belong to it). Groups/individual-students in the UI resolve to per-session entries.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExamRequest"
              },
              "examples": {
                "separateTime": {
                  "summary": "Separate-time exam (own date)",
                  "value": {
                    "name": "Midterm — Algebra",
                    "notes": "Chapters 1–4",
                    "deliveryType": "SeparateTime",
                    "maxGrade": 80,
                    "successScore": 40,
                    "sessions": [
                      {
                        "sessionId": 36,
                        "examDate": "2026-07-20"
                      }
                    ]
                  }
                },
                "duringSession": {
                  "summary": "During-session exam (linked occurrence)",
                  "value": {
                    "name": "Weekly Quiz",
                    "deliveryType": "DuringSession",
                    "maxGrade": 50,
                    "successScore": 25,
                    "sessions": [
                      {
                        "sessionId": 36,
                        "sessionOccurrenceId": 1140
                      }
                    ]
                  }
                },
                "multiSession": {
                  "summary": "Multi-session + student subset",
                  "value": {
                    "name": "Unit Exam",
                    "deliveryType": "SeparateTime",
                    "maxGrade": 100,
                    "successScore": 50,
                    "sessions": [
                      {
                        "sessionId": 36,
                        "examDate": "2026-07-21",
                        "studentIds": [
                          761,
                          762
                        ]
                      },
                      {
                        "sessionId": 37,
                        "examDate": "2026-07-21"
                      }
                    ]
                  }
                },
                "arabicName": {
                  "summary": "Arabic name (single name, AR or EN)",
                  "value": {
                    "name": "امتحان الجبر النهائي",
                    "deliveryType": "SeparateTime",
                    "maxGrade": 30,
                    "successScore": 15,
                    "sessions": [
                      {
                        "sessionId": 37,
                        "examDate": "2026-07-22"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeExamCreated"
                },
                "example": {
                  "success": true,
                  "code": "ExamCreated",
                  "message": "Exam created successfully",
                  "data": {
                    "examId": 12,
                    "name": "Weekly Quiz",
                    "deliveryType": "DuringSession",
                    "maxGrade": 50,
                    "successScore": 25,
                    "sessionsCount": 1,
                    "studentsAssigned": 3,
                    "sessions": [
                      {
                        "sessionId": 36,
                        "occurrenceId": 14,
                        "examDate": "2026-07-12T00:00:00",
                        "studentsAssigned": 3
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "examples": {
                  "ExamRequiresSession": {
                    "value": {
                      "success": false,
                      "code": "ExamRequiresSession",
                      "message": "An exam must be assigned to at least one session"
                    }
                  },
                  "SuccessScoreExceedsMax": {
                    "value": {
                      "success": false,
                      "code": "SuccessScoreExceedsMax",
                      "message": "Success score cannot be greater than the exam's maximum grade"
                    }
                  },
                  "ExamRequiresMaxGrade": {
                    "value": {
                      "success": false,
                      "code": "ExamRequiresMaxGrade",
                      "message": "Exam assignments require a maximum grade greater than zero"
                    }
                  },
                  "DuplicateSessionInExam": {
                    "value": {
                      "success": false,
                      "code": "DuplicateSessionInExam",
                      "message": "The same session was selected more than once for this exam"
                    }
                  },
                  "SessionOccurrenceRequired": {
                    "value": {
                      "success": false,
                      "code": "SessionOccurrenceRequired",
                      "message": "A session date must be selected for a during-session exam"
                    }
                  },
                  "ExamDateRequired": {
                    "value": {
                      "success": false,
                      "code": "ExamDateRequired",
                      "message": "An exam date is required for a separate-time exam"
                    }
                  },
                  "AssignmentDateInPast": {
                    "value": {
                      "success": false,
                      "code": "AssignmentDateInPast",
                      "message": "Assignment date must be today or a future date"
                    }
                  },
                  "StudentNotInSession": {
                    "value": {
                      "success": false,
                      "code": "StudentNotInSession",
                      "message": "One or more selected students do not belong to the selected session"
                    }
                  },
                  "SessionNotFoundOrForeign": {
                    "value": {
                      "success": false,
                      "code": "SessionNotFoundOrForeign",
                      "message": "The selected session was not found or does not belong to you"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Referenced session occurrence not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                },
                "example": {
                  "success": false,
                  "code": "SessionOccurrenceNotFound",
                  "message": "The selected session date was not found or does not belong to the session"
                }
              }
            }
          }
        }
      }
    },
    "/api/exams/session-dates": {
      "get": {
        "tags": [
          "Exams"
        ],
        "summary": "Session occurrences for a month (during-session date picker)",
        "parameters": [
          {
            "name": "sessionId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 36
          },
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 2026
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "example": 7
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "code": "Success",
                  "message": "Done successfully",
                  "data": [
                    {
                      "sessionOccurrenceId": 1139,
                      "date": "2026-07-11T00:00:00",
                      "status": "Pending"
                    },
                    {
                      "sessionOccurrenceId": 1140,
                      "date": "2026-07-12T00:00:00",
                      "status": "Pending"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid month/year",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "code": "InvalidMonth",
                  "message": "Please provide a valid month and year"
                }
              }
            }
          },
          "404": {
            "description": "Session not found / not yours",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "code": "SessionNotFoundOrForeign",
                  "message": "The selected session was not found or does not belong to you"
                }
              }
            }
          }
        }
      }
    },
