{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "Cors": {
    "Origins": [
      "https://admin.edvanz.com"
    ]
  },
  "ConnectionStrings": {
    // The prod connection string is NOT committed. It is provided at runtime by Azure App Service
    // configuration (app setting "ConnectionStrings__con"), which CI sets from the PROD_SQL_CONNECTION
    // secret on every deploy (see .github/workflows/deploy.yml). Do not put a real connection string
    // here. NOTE: the previously committed credential is still in git history and must be ROTATED.
  },
  "Redis": {
    // The Azure App Service setting Redis__Connection (Upstash) overrides this when set.
    // Empty => in-memory IDistributedCache. This stops production from inheriting the
    // appsettings.json default "localhost:6379" (unreachable on Azure), which caused
    // ~6s/request connect-timeout latency on every authenticated call and made the money
    // idempotency guard fail open (double-submit possible). For shared, restart-safe
    // idempotency across scaled-out instances, set Redis__Connection to the Upstash string.
    "Connection": ""
  },
  "JwtSettings": {
    "Key": "SUPER_SECRET_KEY_EDVanz_edvanzz_OMRANBELAL"
  }
}