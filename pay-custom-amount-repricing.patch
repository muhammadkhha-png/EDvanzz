@@ -1,6 +1,16 @@
     public bool HasCustomAmount { get; set; }
     public decimal? CustomAmount { get; set; }
+
+    /// <summary>
+    /// The per-period price now IN FORCE for this student: the custom amount when one is set,
+    /// otherwise the session's default amount. Null when the student has no session assignment.
+    ///
+    /// REQ-PAY-016: distinct from <see cref="AmountDue"/>, which is what the earliest OUTSTANDING
+    /// period actually charges — that period may be pro-rated (REQ-PAY-021) or partially settled,
+    /// so the two legitimately differ. Frontends should show AmountDue for "collect now" and
+    /// EffectiveAmount for "this student's price".
+    /// </summary>
+    public decimal? EffectiveAmount { get; set; }
 }
diff --git a/Edvanz.Application/Dtos/Payment/PaymentDtos.cs b/Edvanz.Application/Dtos/Payment/PaymentDtos.cs
--- a/Edvanz.Application/Dtos/Payment/PaymentDtos.cs
+++ b/Edvanz.Application/Dtos/Payment/PaymentDtos.cs
@@ -1,10 +1,38 @@
 public class SetCustomAmountDto
 {
     public long TeacherId { get; set; }
     public long TeacherStudentId { get; set; }
     public decimal? CustomAmount { get; set; }
 }
 
+/// <summary>
+/// Outcome of setting or clearing a student's custom payment amount.
+/// REQ-PAY-016: reports how many upcoming periods were actually re-priced, so the UI can
+/// confirm the change took effect ("Applied to N upcoming months") instead of silently
+/// storing a price the payment engine ignores.
+/// </summary>
+public class SetCustomAmountResultDto
+{
+    /// <summary>The override now stored; null means the override was cleared (session default).</summary>
+    public decimal? CustomAmount { get; set; }
+
+    /// <summary>
+    /// The price applied to the re-priced periods: the custom amount, or the session's default
+    /// when the override was cleared. Null when the student has no session assignment — the
+    /// override is still stored and will apply at the next assignment.
+    /// </summary>
+    public decimal? EffectiveAmount { get; set; }
+
+    /// <summary>Number of upcoming untouched periods whose AmountDue was rewritten. Zero is a
+    /// valid outcome (no session, nothing upcoming, or the price did not actually change).</summary>
+    public int RepricedPeriodCount { get; set; }
+
+    /// <summary>PeriodStart of the earliest re-priced period; null when none were re-priced.</summary>
+    public DateTime? EffectiveFrom { get; set; }
+
+    /// <summary>Signed change applied to StudentPaymentCounter.TotalOutstanding.</summary>
+    public decimal OutstandingDelta { get; set; }
+}
+
 // ══════════════════════════════════════════════════════════════════════════
 // UNPAID OVERVIEW DTOs
 // ══════════════════════════════════════════════════════════════════════════
