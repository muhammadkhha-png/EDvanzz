diff --git a/Edvanz.Application/Services/PaymentService.cs b/Edvanz.Application/Services/PaymentService.cs
--- a/Edvanz.Application/Services/PaymentService.cs
+++ b/Edvanz.Application/Services/PaymentService.cs
@@ -1,26 +1,152 @@
     /// <inheritdoc />
-    public async Task<Result<bool>> SetCustomAmountAsync(SetCustomAmountDto dto)
+    public async Task<Result<SetCustomAmountResultDto>> SetCustomAmountAsync(SetCustomAmountDto dto)
+    {
+        // StudentPaymentCounter carries a RowVersion, so a collection at another barcode station
+        // can conflict with the re-price. Bounded retry, same contract as
+        // UpdatePaymentCounterAfterCollectionAsync: assigning a price is idempotent, so a clean
+        // re-read and re-apply is always safe. ApplyCustomAmountAsync rolls back before throwing.
+        for (int attempt = 0; ; attempt++)
+        {
+            try
+            {
+                return await ApplyCustomAmountAsync(dto);
+            }
+            catch (Exception ex) when (ex.GetType().Name == "DbUpdateConcurrencyException"
+                && attempt < PaymentConstants.MaxConcurrencyRetries - 1)
+            {
+                // Retry with a fresh read of the counter and the periods.
+            }
+        }
+    }
+
+    /// <summary>
+    /// Single attempt at REQ-PAY-016: store the override on the counter, re-price the student's
+    /// upcoming untouched periods, and reconcile TotalOutstanding — all in one transaction so a
+    /// partial re-price can never be committed.
+    /// </summary>
+    private async Task<Result<SetCustomAmountResultDto>> ApplyCustomAmountAsync(SetCustomAmountDto dto)
     {
         // PAY-4: a custom price must be positive. A negative/zero amount would drive negative dues
         // and negative expected revenue on the next assignment or period regeneration. Null is
         // allowed — it clears the override and reverts the student to the session default.
         if (dto.CustomAmount.HasValue && dto.CustomAmount.Value <= 0m)
-            return Result<bool>.Failure(
+            return Result<SetCustomAmountResultDto>.Failure(
                 _localizer, PaymentConstants.Messages.PaymentCustomAmountInvalid,
                 HttpStatusCode.UnprocessableEntity);
 
         var counter = await _unitOfWork.PaymentsRepo
             .GetPaymentCounterAsync(dto.TeacherId, dto.TeacherStudentId);
         if (counter is null)
-            return Result<bool>.Failure(
+            return Result<SetCustomAmountResultDto>.Failure(
+                _localizer, PaymentConstants.Messages.StudentNotFound, HttpStatusCode.NotFound);
+
+        // Tenant-scoped, active-only: a recycled student must not have their price rewritten.
+        var student = await _unitOfWork.Students.GetActiveByIdAndTeacherAsync(
+            dto.TeacherStudentId, dto.TeacherId);
+        if (student is null)
+            return Result<SetCustomAmountResultDto>.Failure(
                 _localizer, PaymentConstants.Messages.StudentNotFound, HttpStatusCode.NotFound);
 
-        counter.CustomPaymentAmount = dto.CustomAmount;
-        await _unitOfWork.PaymentsRepo.UpdatePaymentCounterAsync(counter);
-        await _unitOfWork.SaveChangesAsync();
+        // The session supplies the fallback price when the override is being CLEARED, and its
+        // PaymentType decides the re-pricing cutoff. An unassigned student has no periods to
+        // re-price: the override is still stored and applies at the next assignment.
+        var session = student.SessionId.HasValue
+            ? await _unitOfWork.SessionsRepo.GetByIdAndTeacherAsync(student.SessionId.Value, dto.TeacherId)
+            : null;
+
+        decimal? effectiveAmount = dto.CustomAmount ?? session?.SessionAmount;
+
+        bool ownsTransaction = !_unitOfWork.HasActiveTransaction;
+        if (ownsTransaction)
+            await _unitOfWork.BeginTransactionAsync();
+
+        try
+        {
+            counter.CustomPaymentAmount = dto.CustomAmount;
+
+            int repricedCount = 0;
+            decimal outstandingDelta = 0m;
+            DateTime? effectiveFrom = null;
+
+            if (session is not null && effectiveAmount.HasValue)
+            {
+                // FORWARD-ONLY cutoff. Monthly re-prices from the first day of the teacher's
+                // current local month (Africa/Cairo, CLAUDE.md §7.4) so the month in progress is
+                // included when nothing has been collected against it yet. PerSession re-prices
+                // from today, since each occurrence is its own obligation.
+                var localDate = _timeZoneService.GetTeacherLocalDate(dto.TeacherId);
+                var fromPeriodStart = session.PaymentType == PaymentType.Monthly
+                    ? new DateTime(localDate.Year, localDate.Month, 1)
+                    : localDate.Date;
+
+                var repriceable = await _unitOfWork.PaymentsRepo.GetRepriceablePeriodsAsync(
+                    dto.TeacherId, dto.TeacherStudentId, student.SessionId, fromPeriodStart);
+
+                foreach (var period in repriceable)
+                {
+                    // REQ-PAY-021/022: a pro-rated period keeps the fraction it was generated with
+                    // (the join date does not change because the price did) — only the base moves.
+                    decimal newAmountDue = period.IsProRated
+                        ? Math.Round(effectiveAmount.Value * period.ProRatedFraction, 2)
+                        : effectiveAmount.Value;
+
+                    if (newAmountDue == period.AmountDue) continue;
+
+                    outstandingDelta += newAmountDue - period.AmountDue;
+                    period.AmountDue = newAmountDue;
+                    // AmountPaid == 0 is guaranteed by the repo filter, so the only consistent
+                    // status is Unpaid. Set explicitly rather than assumed: a period generated
+                    // with AmountDue = 0 could otherwise be sitting on a stale Paid.
+                    period.PaymentStatus = PaymentStatus.Unpaid;
+                    await _unitOfWork.PaymentsRepo.UpdatePaymentPeriodAsync(period);
+
+                    effectiveFrom ??= period.PeriodStart;
+                    repricedCount++;
+                }
+
+                if (outstandingDelta != 0m)
+                {
+                    counter.TotalOutstanding += outstandingDelta;
+                    if (counter.TotalOutstanding < 0m) counter.TotalOutstanding = 0m;
+                }
+            }
+
+            await _unitOfWork.PaymentsRepo.UpdatePaymentCounterAsync(counter);
+            await _unitOfWork.SaveChangesAsync();
+
+            if (ownsTransaction)
+                await _unitOfWork.CommitAsync();
 
-        return Result<bool>.Success(true, _localizer, PaymentConstants.Messages.CustomAmountSetSuccess);
+            return Result<SetCustomAmountResultDto>.Success(new SetCustomAmountResultDto
+            {
+                CustomAmount = dto.CustomAmount,
+                EffectiveAmount = effectiveAmount,
+                RepricedPeriodCount = repricedCount,
+                EffectiveFrom = effectiveFrom,
+                OutstandingDelta = outstandingDelta
+            }, _localizer, PaymentConstants.Messages.CustomAmountSetSuccess);
+        }
+        catch
+        {
+            if (ownsTransaction)
+                await _unitOfWork.RollbackAsync();
+            throw;
+        }
     }
