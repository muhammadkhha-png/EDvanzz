     /// <summary>
     /// Sets a custom payment amount for a student.
     /// REQ-PAY-016: Overrides session default for all future collections.
     /// BR-PAY-003: Not affected by session amount changes.
+    ///
+    /// Also RE-PRICES the student's upcoming untouched periods (current local month onward,
+    /// AmountPaid == 0, not carried forward) so the new price takes effect for an already
+    /// enrolled student, and reconciles StudentPaymentCounter.TotalOutstanding by the delta.
+    /// Passing a null amount clears the override and re-prices back to the session default.
     /// </summary>
-    Task<Result<bool>> SetCustomAmountAsync(SetCustomAmountDto dto);
+    Task<Result<SetCustomAmountResultDto>> SetCustomAmountAsync(SetCustomAmountDto dto);
 
     // ══════════════════════════════════════════════
