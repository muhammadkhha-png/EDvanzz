     Task<PaymentPeriod?> GetLatestPaidPeriodAsync(long teacherId, long teacherStudentId, long? sessionId);
 
     /// <summary>
+    /// Periods eligible for re-pricing when a student's custom payment amount changes
+    /// (REQ-PAY-016 / BR-PAY-003): the student's periods for the session that start on or after
+    /// <paramref name="fromPeriodStart"/>, have received no cash (<c>AmountPaid == 0</c>), and were
+    /// not carried forward from another session. Earliest-first by PeriodSequence.
+    ///
+    /// TRACKED (no AsNoTracking) — the caller rewrites <c>AmountDue</c> in place and lets the
+    /// UnitOfWork save, same contract as <see cref="GetUnpaidPeriodsThroughAsync"/>. Settled and
+    /// partially-settled periods are excluded by the AmountPaid filter: re-pricing a period that
+    /// already holds cash would invalidate money the tutor has collected.
+    /// </summary>
+    Task<List<PaymentPeriod>> GetRepriceablePeriodsAsync(
+        long teacherId, long teacherStudentId, long? sessionId, DateTime fromPeriodStart);
+
+    /// <summary>
     /// Gets a payment period by ID.
     /// </summary>
     Task<PaymentPeriod?> GetPaymentPeriodByIdAsync(long paymentPeriodId);
