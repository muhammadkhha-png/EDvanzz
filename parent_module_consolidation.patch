-        new ObjectResult(new { success = false, code = message, message = _localizer[message].Value })
-        {
-            StatusCode = (int)HttpStatusCode.NotFound,
-        };
-
-    private IActionResult ForbiddenError(string message) =>
-        new ObjectResult(new { success = false, code = message, message = _localizer[message].Value })
