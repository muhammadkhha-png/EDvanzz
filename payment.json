{
    "project": "Edvanz",
    "description": "API design for the Edvanz payment screens. Format: simple endpoint JSON. Each field value is a type hint the backend can map to models. Amounts are numeric (currency is fixed app-wide, so it is not returned per response).",
    "baseUrl": "/api/v1",
    "auth": "All endpoints require a logged-in teacher (bearer token).",
    "screens": [
      {
        "screen": "PaymentTracking",
        "description": "Monthly overview: summary card, status breakdown, collected-by-assistant, collected-by-session. One aggregate load endpoint, plus a separate students-by-status list.",
        "endpoints": [
          {
            "name": "Get payment tracking screen",
            "method": "GET",
            "path": "/payments/tracking",
            "auth": "bearer",
            "description": "Everything the screen renders on load for a selected month. Month arrows re-call with a different month.",
            "request": {
              "params": {},
              "query": {
                "month": "string (YYYY-MM, e.g. '2026-03')"
              },
              "body": {}
            },
            "response": {
              "200": {
                "month": "string (YYYY-MM)",
                "monthLabel": "string (e.g. 'March 2026')",
                "summary": {
                  "expectedRevenue": "number",
                  "totalStudents": "int",
                  "totalSessions": "int",
                  "collectedAmount": "number",
                  "remainingAmount": "number",
                  "sessionsCollected": "int",
                  "sessionsTotal": "int",
                  "progressPercent": "number (0-100)"
                },
                "statusBreakdown": {
                  "paid": "int",
                  "prorated": "int",
                  "unpaid": "int"
                },
                "collectedByAssistant": {
                  "totalCollected": "number",
                  "assistants": [
                    {
                      "id": "string",
                      "name": "string",
                      "avatarUrl": "string (nullable)",
                      "role": "string (e.g. 'Assistant')",
                      "transactionCount": "int",
                      "collectedAmount": "number"
                    }
                  ]
                },
                "collectedBySessions": {
                  "sessions": [
                    {
                      "id": "string",
                      "title": "string (e.g. 'Saturday - 5 pm - prep3')",
                      "day": "string (e.g. 'Saturday')",
                      "time": "string (e.g. '5 pm')",
                      "grade": "string (e.g. 'prep3')",
                      "collectedAmount": "number",
                      "studentsCollected": "int",
                      "studentsTotal": "int",
                      "progressPercent": "number (0-100)"
                    }
                  ]
                }
              },
              "401": { "error": "string" },
              "422": { "error": "string (invalid month format)" }
            }
          },
          {
            "name": "List students by payment status",
            "method": "GET",
            "path": "/payments/students",
            "auth": "bearer",
            "description": "Opened by the 'View' action on the Paid / Pro-rated / Unpaid cards. Paginated list filtered by status. Response carries the month's total collected, the standard month amount, and per-student amounts (incl. unpaid amounts for unpaid/pro-rated students).",
            "request": {
              "params": {},
              "query": {
                "month": "string (YYYY-MM)",
                "status": "string (paid | prorated | unpaid)",
                "page": "int (optional, default 1)",
                "limit": "int (optional, default 20)"
              },
              "body": {}
            },
            "response": {
              "200": {
                "month": "string (YYYY-MM)",
                "monthLabel": "string (e.g. 'March 2026')",
                "status": "string (paid | prorated | unpaid)",
                "totalCollected": "number (total collected across this status group for the month)",
                "monthAmount": "number (standard amount expected for this month)",
                "amountPerMonth": "number (default recurring monthly fee)",
                "totalUnpaidAmount": "number (only for status=unpaid/prorated, total outstanding across the group; 0 otherwise)",
                "total": "int",
                "page": "int",
                "limit": "int",
                "students": [
                  {
                    "id": "string",
                    "name": "string",
                    "avatarUrl": "string (nullable)",
                    "status": "string (paid | prorated | unpaid)",
                    "amountPerMonth": "number (this student's monthly amount)",
                    "amountPaid": "number (collected from this student for the month)",
                    "amountDue": "number (amount owed for the month)",
                    "unpaidAmount": "number (outstanding balance; 0 when paid)",
                    "unpaidMonths": "int (number of unpaid months; 0 when paid)"
                  }
                ]
              },
              "401": { "error": "string" },
              "422": { "error": "string (invalid status or month)" }
            }
          }
        ]
      },
      {
        "screen": "AssistantWallet",
        "description": "A single assistant's wallet: total cash collected, current balance, paginated recent collections, and a withdraw action.",
        "endpoints": [
          {
            "name": "Get assistant wallet screen",
            "method": "GET",
            "path": "/assistants/{assistantId}/wallet",
            "auth": "bearer",
            "description": "Top wallet card + 'Current Collections' list in one call. Collections list is paginated ('View all').",
            "request": {
              "params": { "assistantId": "string" },
              "query": {
                "page": "int (optional, default 1)",
                "limit": "int (optional, default 20)"
              },
              "body": {}
            },
            "response": {
              "200": {
                "assistant": {
                  "id": "string",
                  "name": "string",
                  "role": "string (e.g. 'Assistant')",
                  "avatarUrl": "string (nullable)",
                  "transactionCount": "int"
                },
                "wallet": {
                  "totalCashCollected": "number",
                  "walletBalance": "number",
                  "collectionsCount": "int",
                  "lastActivityAt": "string (ISO datetime)"
                },
                "collections": {
                  "total": "int",
                  "page": "int",
                  "limit": "int",
                  "items": [
                    {
                      "id": "string",
                      "studentId": "string",
                      "studentName": "string",
                      "studentCode": "string (e.g. '#223')",
                      "sessionName": "string",
                      "amount": "number",
                      "collectedAt": "string (ISO datetime)"
                    }
                  ]
                }
              },
              "401": { "error": "string" },
              "404": { "error": "string (assistant not found)" }
            }
          },
          {
            "name": "Request wallet withdrawal",
            "method": "POST",
            "path": "/assistants/{assistantId}/wallet/withdraw",
            "auth": "bearer",
            "description": "The 'Withdraw' button. Money-movement — backend must enforce auth and balance checks.",
            "request": {
              "params": { "assistantId": "string" },
              "query": {},
              "body": {
                "amount": "number (defaults to full balance if omitted)"
              }
            },
            "response": {
              "200": {
                "withdrawalId": "string",
                "status": "string (pending | completed)",
                "amount": "number",
                "walletBalanceAfter": "number",
                "requestedAt": "string (ISO datetime)"
              },
              "401": { "error": "string" },
              "409": { "error": "string (insufficient balance)" }
            }
          }
        ]
      },
      {
        "screen": "SessionPaymentCollectedByMonth",
        "description": "Paginated ledger of collected student payments, filtered by month and year.",
        "endpoints": [
          {
            "name": "Get session payments collected by month",
            "method": "GET",
            "path": "/payments/collections",
            "auth": "bearer",
            "description": "The table. Filter per month + year; paginate by page number. Row Actions icon opens that payment's detail via its id.",
            "request": {
              "params": {},
              "query": {
                "month": "int (1-12, required)",
                "year": "int (e.g. 2026, required)",
                "page": "int (default 1)",
                "limit": "int (optional, default 20)"
              },
              "body": {}
            },
            "response": {
              "200": {
                "month": "int (1-12)",
                "year": "int",
                "monthLabel": "string (e.g. 'December 2016')",
                "page": "int",
                "limit": "int",
                "totalItems": "int",
                "totalPages": "int",
                "items": [
                  {
                    "id": "string (payment id)",
                    "index": "int (1-based row number)",
                    "studentId": "string",
                    "studentName": "string",
                    "amount": "number",
                    "status": "string (collected | pending)",
                    "sessionName": "string (nullable)",
                    "collectedAt": "string (ISO datetime, nullable)"
                  }
                ]
              },
              "401": { "error": "string" },
              "422": { "error": "string (invalid month/year)" }
            }
          }
        ]
      },
      {
        "screen": "SessionPaymentCollectedByYear",
        "description": "Paginated per-student table showing each month's collection status across a selected year.",
        "endpoints": [
          {
            "name": "Get session payments collected by year",
            "method": "GET",
            "path": "/payments/collections/yearly",
            "auth": "bearer",
            "description": "The year table. Filter per year; paginate by page number. Each row is a student with a 12-month status matrix + a summary. Row/cell Actions icon opens that student's monthly detail.",
            "request": {
              "params": {},
              "query": {
                "year": "int (e.g. 2026, required)",
                "page": "int (default 1)",
                "limit": "int (optional, default 20)"
              },
              "body": {}
            },
            "response": {
              "200": {
                "year": "int",
                "page": "int",
                "limit": "int",
                "totalItems": "int",
                "totalPages": "int",
                "items": [
                  {
                    "id": "string (student id)",
                    "index": "int (1-based row number)",
                    "studentName": "string",
                    "summary": {
                      "paidMonths": "int",
                      "unpaidMonths": "int",
                      "totalCollected": "number",
                      "label": "string (e.g. 'Paid 4 months, unpaid 2 months')"
                    },
                    "months": [
                      {
                        "month": "int (1-12)",
                        "status": "string (paid | unpaid | prorated)",
                        "amount": "number"
                      }
                    ]
                  }
                ]
              },
              "401": { "error": "string" },
              "422": { "error": "string (invalid year)" }
            }
          }
        ]
      },
      {
        "screen": "CollectPayment",
        "description": "Searchable, filterable, paginated student list for collecting payments. Rows are selectable for a bulk mark-as-paid action.",
        "endpoints": [
          {
            "name": "List students for payment collection",
            "method": "GET",
            "path": "/payments/collect/students",
            "auth": "bearer",
            "description": "The list. Filter tabs (All / Assigned / Unassigned) + search + pagination. Each item carries payment status and unpaid month count.",
            "request": {
              "params": {},
              "query": {
                "filter": "string (all | assigned | unassigned, default all)",
                "search": "string (optional, name query)",
                "page": "int (default 1)",
                "limit": "int (optional, default 20)"
              },
              "body": {}
            },
            "response": {
              "200": {
                "counts": {
                  "all": "int",
                  "assigned": "int",
                  "unassigned": "int"
                },
                "page": "int",
                "limit": "int",
                "totalItems": "int",
                "totalPages": "int",
                "students": [
                  {
                    "id": "string",
                    "name": "string",
                    "avatarUrl": "string (nullable)",
                    "amount": "number",
                    "assignment": "string (assigned | unassigned)",
                    "status": "string (paid | unpaid)",
                    "unpaidMonths": "int (0 when paid)"
                  }
                ]
              },
              "401": { "error": "string" },
              "422": { "error": "string (invalid filter)" }
            }
          },
          {
            "name": "Bulk mark students as paid",
            "method": "POST",
            "path": "/payments/collect/mark-paid",
            "auth": "bearer",
            "description": "The 'Mark N students as Paid' bottom action. Money-affecting — backend must validate each student.",
            "request": {
              "params": {},
              "query": {},
              "body": {
                "studentIds": "string[] (selected student ids)"
              }
            },
            "response": {
              "200": {
                "markedPaidCount": "int",
                "results": [
                  { "studentId": "string", "status": "string (paid | failed)", "reason": "string (nullable)" }
                ]
              },
              "401": { "error": "string" },
              "422": { "error": "string (no students selected)" }
            }
          }
        ]
      },
      {
        "screen": "CollectPaymentSession",
        "description": "QR/code collection flow. Backend only resolves a scan into a student+amount and accepts the final submitted batch. Checking in, reverting, editing amounts, and deleting are all client-side local state until submit.",
        "endpoints": [
          {
            "name": "Resolve student by QR or code",
            "method": "GET",
            "path": "/collect/lookup",
            "auth": "bearer",
            "description": "On successful QR scan or typed code/name. Returns the student and the amount they should pay; the client saves it locally.",
            "request": {
              "params": {},
              "query": {
                "qr": "string (nullable, raw QR payload)",
                "code": "string (nullable, student code)",
                "name": "string (nullable, name query)"
              },
              "body": {}
            },
            "response": {
              "200": {
                "student": {
                  "id": "string",
                  "name": "string",
                  "code": "string (e.g. '#223')",
                  "group": "string (e.g. 'A2')",
                  "avatarUrl": "string (nullable)"
                },
                "amountDue": "number",
                "paymentStatus": "string (paid | unpaid)"
              },
              "401": { "error": "string" },
              "404": { "error": "string (no student found for QR/code)" }
            }
          },
          {
            "name": "Submit collected payments",
            "method": "POST",
            "path": "/collect/submit",
            "auth": "bearer",
            "description": "The 'Submit (N) students' action. Sends the final list of students + amounts after all client-side edits/deletes/reverts. Money-affecting — backend must validate each student.",
            "request": {
              "params": {},
              "query": {},
              "body": {
                "month": "string (YYYY-MM, nullable)",
                "classSessionId": "string (nullable)",
                "students": [
                  {
                    "studentId": "string",
                    "amount": "number"
                  }
                ]
              }
            },
            "response": {
              "200": {
                "submittedCount": "int",
                "totalCollected": "number",
                "results": [
                  {
                    "studentId": "string",
                    "status": "string (committed | failed)",
                    "reason": "string (nullable)"
                  }
                ]
              },
              "401": { "error": "string" },
              "409": { "error": "string (already submitted / empty batch)" }
            }
          }
        ]
      }
    ]
  }