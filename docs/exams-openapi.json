    "/api/exams/grades": {
      "put": {
        "tags": [
          "Exam grades & attendance"
        ],
        "summary": "Save a batch of distinct per-student grades",
        "description": "Each item carries its own `grade` and `rowVersion` (echo the `rowVersion` you last read for that student). Valid rows are applied and returned with a **fresh** `rowVersion`; invalid rows come back with a `code`. `0 ≤ grade ≤ maxGrade`. Entering a grade marks the student `AttendedWithGrade`; send `grade: null` to **clear** an entered grade — the student reverts to `Attended` (attendance kept), and a clear skips the range/absent/during-session guards. A during-session student who is not yet `Attended` cannot be graded (`AttendanceNotRecordedForExam`). Any stale `rowVersion` fails the whole batch with 409.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchGradeRequest"
              },
              "examples": {
                "setGrades": {
                  "summary": "Enter / update grades",
                  "value": {
                    "items": [
                      {
                        "obligationId": 3,
                        "grade": 70,
                        "rowVersion": "AAAAAAAAB9E="
                      },
                      {
                        "obligationId": 4,
                        "grade": 45,
                        "rowVersion": "AAAAAAAAB9I="
                      },
                      {
                        "obligationId": 5,
                        "grade": 30,
                        "rowVersion": "AAAAAAAAB9M="
                      }
                    ]
                  }
                },
                "clearGrade": {
                  "summary": "Clear a grade (null) - student stays Attended",
                  "value": {
                    "items": [
                      {
                        "obligationId": 3,
                        "grade": null,
                        "rowVersion": "AAAAAAAAB+E="
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processed. Check `allSucceeded` and each item. Failing item codes: `GradeExceedsMax`, `GradeOutOfRange`, `CannotGradeAbsentStudent`, `AttendanceNotRecordedForExam`, `ObligationNotFound`, `NotAnExam`. A `null` grade clears the row (status → `Attended`, `grade: null`).\n",
            "content": {
              "application/json": {
                "examples": {
                  "allSucceeded": {
                    "value": {
                      "success": true,
                      "code": "GradesSaved",
                      "message": "Grades saved",
                      "data": {
                        "updatedCount": 3,
                        "allSucceeded": true,
                        "items": [
                          {
                            "obligationId": 3,
                            "success": true,
                            "code": null,
                            "status": "AttendedWithGrade",
                            "grade": 70.0,
                            "rowVersion": "AAAAAAAAB+E="
                          },
                          {
                            "obligationId": 4,
                            "success": true,
                            "code": null,
                            "status": "AttendedWithGrade",
                            "grade": 45.0,
                            "rowVersion": "AAAAAAAAB+I="
                          },
                          {
                            "obligationId": 5,
                            "success": true,
                            "code": null,
                            "status": "AttendedWithGrade",
                            "grade": 30.0,
                            "rowVersion": "AAAAAAAAB+M="
                          }
                        ]
                      }
                    }
                  },
                  "clearedGrade": {
                    "summary": "A cleared grade - status reverts to Attended, grade null",
                    "value": {
                      "success": true,
                      "code": "GradesSaved",
                      "message": "Grades saved",
                      "data": {
                        "updatedCount": 1,
                        "allSucceeded": true,
                        "items": [
                          {
                            "obligationId": 3,
                            "success": true,
                            "code": null,
                            "status": "Attended",
                            "grade": null,
                            "rowVersion": "AAAAAAAAB+Q="
                          }
                        ]
                      }
                    }
                  },
                  "partialFailure": {
                    "summary": "One row over the max, and a during-session guard hit",
                    "value": {
                      "success": true,
                      "code": "GradesSaved",
                      "message": "Grades saved",
                      "data": {
                        "updatedCount": 0,
                        "allSucceeded": false,
                        "items": [
                          {
                            "obligationId": 3,
                            "success": false,
                            "code": "GradeExceedsMax",
                            "status": null,
                            "grade": null,
                            "rowVersion": null
                          },
                          {
                            "obligationId": 6,
                            "success": false,
                            "code": "AttendanceNotRecordedForExam",
                            "status": null,
                            "grade": null,
                            "rowVersion": null
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Empty or too-large batch",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "code": "BulkItemsEmpty",
                  "message": "Please select at least one student for the bulk action"
                }
              }
            }
          },
          "409": {
            "description": "A stale rowVersion — reload and retry",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "code": "ObligationConcurrencyConflict",
                  "message": "This student record was updated by someone else. Please reload and try again"
                }
              }
            }
          }
        }
      }
    },
    "/api/exams/attendance": {
      "put": {
        "tags": [
          "Exam grades & attendance"
        ],
        "summary": "Take attendance for a separate-time exam (batch present/absent)",
        "description": "`present: true` → `Attended` (keeps an entered grade → `AttendedWithGrade`); `present: false` → `DidNotAttend` (clears any grade). **Rejected for during-session exams** (their attendance comes from the session) with 409 `AttendanceReadOnlyForDuringSession`.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExamAttendanceRequest"
              },
              "example": {
                "occurrenceId": 3,
                "items": [
                  {
                    "obligationId": 3,
                    "present": false
                  },
                  {
                    "obligationId": 4,
                    "present": true
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "code": "ExamAttendanceSaved",
                  "message": "Exam attendance saved",
                  "data": {
                    "updatedCount": 2,
                    "allSucceeded": true,
                    "items": [
                      {
                        "obligationId": 3,
                        "success": true,
                        "code": null,
                        "status": "DidNotAttend",
                        "rowVersion": "AAAAAAAAB+Q="
                      },
                      {
                        "obligationId": 4,
                        "success": true,
                        "code": null,
                        "status": "AttendedWithGrade",
                        "rowVersion": "AAAAAAAAB+U="
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Empty batch",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "code": "BulkItemsEmpty",
                  "message": "Please select at least one student for the bulk action"
                }
              }
            }
          },
          "404": {
            "description": "Occurrence not found",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "code": "OccurrenceNotFound",
                  "message": "Occurrence not found"
                }
              }
            }
          },
          "409": {
            "description": "During-session exam — attendance is read-only here",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "code": "AttendanceReadOnlyForDuringSession",
                  "message": "Attendance for a during-session exam is taken from the session and cannot be changed here"
                }
              }
            }
          }
        }
      }
    },
    "/api/exams/attendance/scan": {
      "post": {
        "tags": [
          "Exam grades & attendance"
        ],
        "summary": "Scan a student QR/code to mark them attended (separate-time exam)",
        "description": "Idempotent — a re-scan returns alreadyProcessed=true. Rejected for during-session exams.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExamScanRequest"
              },
              "example": {
                "occurrenceId": 3,
                "code": "A1B2C3"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scanned (or already processed)",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "code": "ScanRecorded",
                  "message": "Attendance recorded",
                  "data": {
                    "obligationId": 3,
                    "teacherStudentId": 761,
                    "studentName": "Aya Kamal",
                    "studentCode": "A1B2C3",
                    "status": "Attended",
                    "alreadyProcessed": false
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown code, or student not on this exam",
            "content": {
              "application/json": {
                "examples": {
                  "StudentCodeNotFound": {
                    "value": {
                      "success": false,
                      "code": "StudentCodeNotFound",
                      "message": "No student found with this code"
                    }
                  },
                  "ExamStudentNotFound": {
                    "value": {
                      "success": false,
                      "code": "ExamStudentNotFound",
                      "message": "This student is not assigned to this exam"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "During-session exam — attendance is read-only here",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "code": "AttendanceReadOnlyForDuringSession",
                  "message": "Attendance for a during-session exam is taken from the session and cannot be changed here"
                }
              }
            }
          }
        }
      }
    },
    "/api/attendance/dashboard": {
      "get": {
        "tags": [
          "Home / dashboard"
        ],
        "summary": "App home dashboard (extended with exam flags)",
        "description": "Existing attendance dashboard, now with exam awareness — each session card carries `isExamSession` (+ `examId`/`examOccurrenceId`/`examName`) when a during-session exam falls on today's occurrence, and a new `examsToday[]` lists separate-time exams due today. Only the exam-related fields are shown below.\n",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Defaults to the teacher's local today"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "code": "Success",
                  "message": "Done successfully",
                  "data": {
                    "date": "2026-07-11T00:00:00",
                    "sessionCards": [
                      {
                        "sessionId": 36,
                        "sessionName": "Exam Session A",
                        "isExamSession": true,
                        "examId": 6,
                        "examOccurrenceId": 9,
                        "examName": "Today Exam",
                        "markedCount": 3,
                        "totalStudents": 3
                      },
                      {
                        "sessionId": 40,
                        "sessionName": "History",
                        "isExamSession": false,
                        "examId": null,
                        "examOccurrenceId": null,
                        "examName": null,
                        "markedCount": 0,
                        "totalStudents": 12
                      }
                    ],
                    "examsToday": [
                      {
                        "examId": 20,
                        "occurrenceId": 24,
                        "name": "Separate Today",
                        "sessionId": 36,
                        "sessionName": "Exam Session A",
                        "assignedCount": 3,
                        "attendedCount": 0,
                        "missedCount": 0
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Teacher/Assistant access token from `POST /api/auth/login` → `data.accessToken`."
      }
    },
    "schemas": {
      "ExamDeliveryType": {
        "type": "string",
        "enum": [
          "DuringSession",
          "SeparateTime"
        ]
      },
      "ObligationStatus": {
        "type": "string",
        "description": "Exam-relevant statuses.",
        "enum": [
          "Pending",
          "Attended",
          "AttendedWithGrade",
          "DidNotAttend"
        ]
      },
      "CreateExamRequest": {
        "type": "object",
        "required": [
          "name",
          "deliveryType",
          "maxGrade",
          "successScore",
          "sessions"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "description": "Single name — Arabic OR English"
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "deliveryType": {
            "$ref": "#/components/schemas/ExamDeliveryType"
          },
          "maxGrade": {
            "type": "number",
            "minimum": 0.01
          },
          "successScore": {
            "type": "number",
            "description": "0 ≤ successScore ≤ maxGrade"
          },
          "sessions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ExamSessionInput"
            }
          }
        }
      },
      "ExamSessionInput": {
        "type": "object",
        "required": [
          "sessionId"
        ],
        "properties": {
          "sessionId": {
            "type": "integer",
            "format": "int64"
          },
          "sessionOccurrenceId": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "Required when deliveryType = DuringSession"
          },
          "examDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Required when deliveryType = SeparateTime (today or future)"
          },
          "studentIds": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Optional subset of that session's students; omit = all"
          }
        }
      },
      "ExamStats": {
        "type": "object",
        "properties": {
          "totalStudents": {
            "type": "integer"
          },
          "gradedCount": {
            "type": "integer"
          },
          "average": {
            "type": "number",
            "nullable": true
          },
          "highest": {
            "type": "number",
            "nullable": true
          },
          "lowest": {
            "type": "number",
            "nullable": true
          },
          "attendedCount": {
            "type": "integer"
          },
          "missedCount": {
            "type": "integer"
          },
          "pendingCount": {
            "type": "integer"
          },
          "belowPassingCount": {
            "type": "integer"
          }
        }
      },
      "ExamStudentRow": {
        "type": "object",
        "properties": {
          "obligationId": {
            "type": "integer",
            "format": "int64"
          },
          "teacherStudentId": {
            "type": "integer",
            "format": "int64"
          },
          "studentName": {
            "type": "string"
          },
          "studentCode": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ObligationStatus"
          },
          "attended": {
            "type": "boolean"
          },
          "grade": {
            "type": "number",
            "nullable": true
          },
          "isGradeEntered": {
            "type": "boolean"
          },
          "isBelowPassing": {
            "type": "boolean"
          },
          "rowVersion": {
            "type": "string",
            "description": "base64 concurrency token — echo it back when saving this row's grade"
          }
        }
      },
      "BatchGradeRequest": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "obligationId",
                "rowVersion"
              ],
              "properties": {
                "obligationId": {
                  "type": "integer",
                  "format": "int64"
                },
                "grade": {
                  "type": "number",
                  "nullable": true,
                  "description": "0 ≤ grade ≤ maxGrade. Send null to CLEAR the entered grade — the student reverts to Attended (attendance kept)."
                },
                "rowVersion": {
                  "type": "string",
                  "description": "base64 token from the last read of this row"
                }
              }
            }
          }
        }
      },
      "ExamAttendanceRequest": {
        "type": "object",
        "required": [
          "occurrenceId",
          "items"
        ],
        "properties": {
          "occurrenceId": {
            "type": "integer",
            "format": "int64",
            "description": "The exam occurrence id (from the exam view)"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "obligationId",
                "present"
              ],
              "properties": {
                "obligationId": {
                  "type": "integer",
                  "format": "int64"
                },
                "present": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "ExamScanRequest": {
        "type": "object",
        "required": [
          "occurrenceId",
          "code"
        ],
        "properties": {
          "occurrenceId": {
            "type": "integer",
            "format": "int64"
          },
          "code": {
            "type": "string",
            "description": "Student code / scanned QR value"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "code": {
            "type": "string",
            "example": "GradeExceedsMax"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "EnvelopeExamCreated": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "examId": {
                "type": "integer",
                "format": "int64"
              },
              "name": {
                "type": "string"
              },
              "deliveryType": {
                "$ref": "#/components/schemas/ExamDeliveryType"
              },
              "maxGrade": {
                "type": "number"
              },
              "successScore": {
                "type": "number"
              },
              "sessionsCount": {
                "type": "integer"
              },
              "studentsAssigned": {
                "type": "integer"
              },
              "sessions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sessionId": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "occurrenceId": {
                      "type": "integer",
                      "format": "int64"
                    },
                    "examDate": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "studentsAssigned": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}