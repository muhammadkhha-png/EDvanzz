         if (student.SessionId.HasValue)
         {
             var sessionForStatus = await _unitOfWork.SessionsRepo.GetByIdAndTeacherAsync(
                 student.SessionId.Value, teacherId);
             sessionName = sessionForStatus?.SessionName;
